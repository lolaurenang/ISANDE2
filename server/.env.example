# ---------------------------------------------------------------
# Andoy's Enterprises - API environment variables
# Copy this file to ".env" and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# Where the React client runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- DATABASE -------------------------------------------------
# Option A (local, single machine - default for development):
MONGODB_URI=mongodb://127.0.0.1:27017/andoys

# Option B (SHARED cluster - every group member points here):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/andoys?retryWrites=true&w=majority

# --- AUTH -----------------------------------------------------
# Change this to a long random string before any real deployment
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Anyone who signs up with this code is created as a manager.
# Leave blank to force managers to be created by seeding only.
MANAGER_INVITE_CODE=ANDOY-MANAGER-2026
